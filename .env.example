# RelayGPU - /api/translate (OCR + transliterasyon + çeviri + belge analizi) için kullanılır.
# Hangi model kullanılacağı burada değil, configs/llm.yaml içindeki "model" alanında ayarlanır.
RELAY_API_KEY=
RELAY_BASE_URL=

# Google Gemini - yalnızca /api/assistant (metin sohbet asistanı) için kullanılır.
# /api/translate ile ilgisi yoktur, ayrı bir özelliktir.
GEMINI_API_KEY=
